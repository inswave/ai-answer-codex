# watchdog.conf — watchdog.sh 설정 (시크릿 포함, 커밋 금지)
# 서버에서 이 파일을 watchdog.conf 로 복사해 값 채우기:
#   cp scripts/watchdog.conf.example scripts/watchdog.conf

# Discord 웹훅 URL (필수). 채널 설정 → 연동 → 웹훅 → 새 웹훅 → URL 복사.
WEBHOOK="https://discord.com/api/webhooks/xxxxx/yyyyy"

# (선택) 포트 / health 경로 — 기본값과 같으면 생략 가능
# PORT=3000
# HEALTH_PATH="/api/health"

# (선택) 재기동 명령. 비우면 기본 nohup 사용:
#   PORT=$PORT nohup node src/api/server.js >> server.log 2>> server.err.log &
# 평소 기동 명령/로그 파일명이 다르면 여기서 정확히 맞춘다. 예:
# START_CMD='nohup node src/api/server.js >> server.log 2>> server.err.log &'
